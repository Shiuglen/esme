{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "types": ["node", "vite/client"], "isolatedModules": true, "resolveJsonModule": true, "noEmit": true,
    "paths": { "@/*": ["./src/renderer/*"] }
  },
  "include": ["src", "*.config.ts"]
}
